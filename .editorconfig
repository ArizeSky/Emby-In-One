# Editor settings that match .gitattributes, so files are written with LF from the
# start instead of being fixed up afterwards.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt prints tabs for indentation and spaces for alignment, and it wants a final
# newline; the rules above already match it.
[*.go]
indent_style = tab

[*.{js,html,css,json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false

# Vendored files are kept as upstream ships them.
[third_party/**]
insert_final_newline = false
trim_trailing_whitespace = false
